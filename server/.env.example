# Copy this file to ".env" and fill in your own local values.
# Never commit the real .env file. Only placeholders are allowed here.

# PostgreSQL connection string (secret on GCP: Secret Manager toktickit-database-url)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/toktickit?schema=public"
# Port the API listens on (Cloud Run gives 3000 through --port)
PORT=3000
# development locally, production in Docker and on Cloud Run
NODE_ENV=development
# Origin of the web app, used by CORS (only needed when UI and API are on two URLs)
CLIENT_ORIGIN=http://localhost:5173
# true on HTTPS (Cloud Run), false on http://localhost
COOKIE_SECURE=false
# Folder of the built React app served by the API. Empty in local dev, set in the Docker image.
CLIENT_DIST_DIR=
# Password of the seeded demo accounts. Required when NODE_ENV=production
# (secret on GCP: Secret Manager toktickit-seed-password). Empty = local dev password.
SEED_PASSWORD=
